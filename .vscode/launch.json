{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "تشغيل بوت تيليجرام",
      "type": "debugpy",
      "request": "launch",
      "module": "src.main",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "تشغيل اختبارات pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}"
    }
  ]
}

