{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "python -m pip install -r requirements.txt -r requirements-dev.txt"
    },
    {
      "label": "Install Chromium",
      "type": "shell",
      "command": "python -m playwright install --with-deps chromium"
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "python -m pytest",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
